{
  "expo": {
    "name": "MApp",
    "slug": "mapp",
    "scheme": "mapp",
    "version": "1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mapp.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.mapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EEF2FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "READ_MEDIA_IMAGES"
      ],
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "MApp checks which of your contacts already use the app. Only scrambled (hashed) numbers and emails leave your phone."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "MApp uses the microphone for voice messages and voice calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MApp needs your photos to send them in chats.",
          "cameraPermission": "MApp uses the camera to take photos for chats."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "defaultChannel": "messages"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "MApp uses the camera for video calls.",
          "microphonePermission": "MApp uses the microphone for voice calls."
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "MApp saves photos and videos you choose to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
