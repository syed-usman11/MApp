# ---- server ----
PORT=4000
HOST=0.0.0.0
# Leave DATABASE_URL empty to use embedded PGlite (stored in apps/server/data/pglite)
DATABASE_URL=
# Random 32+ byte secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
IDENTITY_PEPPER=change-me-to-a-different-long-random-string
# Public base URL of this server (used to build OAuth redirect URIs)
PUBLIC_URL=http://localhost:4000
# Deep link the mobile app listens on after identity verification
APP_REDIRECT_URL=mapp://auth
# Comma-separated list of identity providers to enable
IDENTITY_PROVIDERS=mock,in.digilocker
# Minimum assurance to create an account: low (dev), substantial, high (production)
REGISTRATION_MIN_ASSURANCE=low
# true = accounts only via national-ID verification; false = plain email/password sign-up
ID_VERIFICATION_REQUIRED=false
# TURN relay for voice calls. Without it, calls between two phones on different mobile
# networks often fail to connect (carrier NAT). Free options: Metered Open Relay
# (dashboard.metered.ca, ~20 GB/month free) or Cloudflare Realtime TURN. Example:
#   TURN_URLS=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turns:a.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Android push notifications, sent straight to Firebase Cloud Messaging. Paste the whole
# service-account JSON (Firebase console > Project settings > Service accounts > Generate
# new private key) as one line, or base64-encode it. The app build also needs
# apps/mobile/google-services.json from the same Firebase project.
FIREBASE_SERVICE_ACCOUNT=
# Email transport for password reset codes. Leave both empty in development: the code is
# printed to the server log and returned to the app as devCode. In production one of these
# is required or password reset reports itself as unavailable.
#   Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com
#          SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords>
#   Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<login> SMTP_PASS=<smtp key>
MAIL_FROM="MApp <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Or Resend (needs a verified domain to send to anyone but yourself)
RESEND_API_KEY=
# Password reset codes: lifetime and login lockout policy
PASSWORD_RESET_TTL_SECONDS=900
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900

# ---- DigiLocker (India / Aadhaar) ----
# Obtain from the DigiLocker partner portal (API Setu). Verify base URLs against your partner docs.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_BASE_URL=https://api.digitallocker.gov.in
